{
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/(favicon\\.ico|manifest\\.json|robots\\.txt|apple-touch-icon\\.png|.*\\.png|.*\\.svg|.*\\.jpg|.*\\.webp|.*\\.woff2?|.*\\.ttf)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
